# Copy this file to .env and fill in real values. Never commit .env.

# Gate.io API credentials (spot trading permission required).
# IMPORTANT: if you ever hardcoded keys in the old n8n workflow, rotate them on
# Gate.io before using this project - treat those old keys as compromised.
GATE_API_KEY=
GATE_API_SECRET=

# Where the SQLite database file lives. Defaults to ./data/cascade.db if unset.
DB_PATH=./data/cascade.db

# When true (default), no real orders are sent to Gate.io - placeOrder/cancelOrder
# just log what they *would* do and fabricate fake order ids/statuses. Always test
# a new cascade config in dry-run first.
DRY_RUN=true

# How often (in seconds) the scheduler checks all active cascades for trigger arming,
# next-level placement, and order fills.
DEFAULT_POLL_INTERVAL_SECONDS=60

PORT=3000
