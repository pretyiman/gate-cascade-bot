# Copy this file to .env and fill in real values. Never commit .env.

# Gate.io API credentials are no longer set here - each user provides their own
# key/secret (Spot trading permission required) after logging in, via the
# Settings screen. They're stored encrypted per-user in the database, not here.

# Where the SQLite database file lives. Defaults to ./data/cascade.db if unset.
DB_PATH=./data/cascade.db

# Master key used to encrypt each user's stored Gate.io API secret at rest
# (AES-256-GCM). Required. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never rotate this without a migration plan - existing encrypted secrets
# become unreadable if this changes.
ENCRYPTION_KEY=

# Operator-level kill switch: when true, forces DRY_RUN behavior for every
# user regardless of what they've set for themselves in Settings.
FORCE_DRY_RUN=false

# Whether the session cookie requires HTTPS. Keep true for anything reachable
# over the internet (e.g. via ngrok). Only set false for plain http://localhost
# development, since browsers silently drop "secure" cookies over plain HTTP.
COOKIE_SECURE=true

# Base URL used to print full invite/reset links from scripts/create-invite.js
# and scripts/create-reset-link.js. Set this to your ngrok/public URL if
# that's where users will actually click the link.
APP_BASE_URL=http://localhost:3000

# How often (in seconds) the scheduler checks all active cascades for trigger arming,
# next-level placement, and order fills.
DEFAULT_POLL_INTERVAL_SECONDS=60

PORT=3000
